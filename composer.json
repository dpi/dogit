{
    "name": "dpi/dogit",
    "type": "application",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "composer/semver": "^3.3.2",
        "czproject/git-php": "^4.1.0",
        "guzzlehttp/guzzle": "^7.8",
        "kevinrob/guzzle-cache-middleware": "^4.1.2",
        "league/flysystem": "^3.15.1",
        "m4tthumphrey/php-gitlab-api": "^11.14",
        "nyholm/psr7": "^1.8.0",
        "php-http/client-common": "^2.7.1",
        "php-http/curl-client": "^2.3.0",
        "php-http/discovery": "^1.19.4",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/httplug-bundle": "^1.27.1",
        "php-http/message": "^1.16.1",
        "psr/http-client": "^1.0.3",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^6.0.19",
        "symfony/console": "^6.0.19",
        "symfony/css-selector": "^6.0.19",
        "symfony/dom-crawler": "^6.0.19",
        "symfony/event-dispatcher": "^6.0.19",
        "symfony/filesystem": "^6.0.19",
        "symfony/finder": "^6.0.19",
        "symfony/process": "^6.0.19",
        "symfony/options-resolver": "^6.0.19"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.16",
        "jangregor/phpstan-prophecy": "^1",
        "mikey179/vfsstream": "^1.6.11",
        "phpstan/extension-installer": "^1.3.1",
        "phpstan/phpstan": "1.10.32",
        "phpstan/phpstan-strict-rules": "^1.5.1",
        "phpstan/phpstan-symfony": "^1.3.2",
        "phpunit/phpunit": "^9.6.7",
        "phpspec/prophecy": "^1.17",
        "phpspec/prophecy-phpunit": "^2.0.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1.99999999"
        }
    },
    "authors": [
        {
            "name": "dpi",
            "email": "pro@danielph.in"
        }
    ],
    "autoload": {
        "psr-4": {
            "dogit\\": "src/",
            "dogit\\tests\\": "tests/"
        }
    },
    "bin": [
        "bin/dogit"
    ],
    "license": "BSD-3-Clause"
}
